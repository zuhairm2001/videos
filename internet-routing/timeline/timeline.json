  "vo": [
    {
      "id": "v01",
      "start": 0.2,
      "end": 1.62,
      "text": "Enter. Where did it go?",
      "file": "audio/voice/segments/v01.wav"
    },
    {
      "id": "v02",
      "start": 2.55,
      "end": 4.36,
      "text": "Let's follow it — and race a blink.",
      "file": "audio/voice/segments/v02.wav"
    },
    {
      "id": "v03",
      "start": 5.75,
      "end": 11.04,
      "text": "Your browser asks D-N-S, the internet's phone book, where example dot com lives.",
      "file": "audio/voice/segments/v03.wav"
    },
    {
      "id": "v04",
      "start": 11.35,
      "end": 12.59,
      "text": "Back comes an address.",
      "file": "audio/voice/segments/v04.wav"
    },
    {
      "id": "v05",
      "start": 13.2,
      "end": 15.01,
      "text": "Data travels in small packets.",
      "file": "audio/voice/segments/v05.wav"
    },
    {
      "id": "v06",
      "start": 15.16,
      "end": 16.59,
      "text": "Your request fits in one.",
      "file": "audio/voice/segments/v06.wav"
    },
    {
      "id": "v07",
      "start": 17.2,
      "end": 20.49,
      "text": "A typical page's H-T-M-L needs about thirteen.",
      "file": "audio/voice/segments/v07.wav"
    },
    {
      "id": "v08",
      "start": 20.64,
      "end": 23.71,
      "text": "Each router reads the address and passes it one step closer.",
      "file": "audio/voice/segments/v08.wav"
    },
    {
      "id": "v09",
      "start": 24.35,
      "end": 28.77,
      "text": "No route is reserved — every router decides again, for every packet.",
      "file": "audio/voice/segments/v09.wav"
    },
    {
      "id": "v10",
      "start": 28.92,
      "end": 31.03,
      "text": "If a link fails, the router picks another.",
      "file": "audio/voice/segments/v10.wav"
    },
    {
      "id": "v11",
      "start": 32.25,
      "end": 34.48,
      "text": "Often, the server is a nearby copy.",
      "file": "audio/voice/segments/v11.wav"
    },
    {
      "id": "v12",
      "start": 35.0,
      "end": 37.71,
      "text": "Thirteen packets stream back and snap into order.",
      "file": "audio/voice/segments/v12.wav"
    },
    {
      "id": "v13",
      "start": 38.3,
      "end": 42.37,
      "text": "The first reply: about forty milliseconds. Faster than a blink!",
      "file": "audio/voice/segments/v13.wav"
    },
    {
      "id": "v14",
      "start": 42.8,
      "end": 44.55,
      "text": "All that, because you hit—",
      "file": "audio/voice/segments/v14.wav"
    }
  ],
